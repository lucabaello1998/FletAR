<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Necesario para IHubContext<ChatHub>/Hub - ChatHub vive acá (no en
         Fletar.API) porque MensajeService necesita inyectar IHubContext<ChatHub>
         para notificar al grupo de la conversación cuando llega un mensaje por
         POST, y Fletar.BLL no puede referenciar Fletar.API (la dependencia va
         al revés: API -> BLL). Este FrameworkReference expone los tipos de
         SignalR server-side sin necesitar el SDK Web completo. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fletar.DAL\Fletar.DAL.csproj" />
    <ProjectReference Include="..\Fletar.DTO\Fletar.DTO.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.73.0" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
