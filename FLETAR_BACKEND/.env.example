# Copiar a .env (no se versiona) y completar.
POSTGRES_DB=fletar
POSTGRES_USER=fletar
POSTGRES_PASSWORD=<password local>
# Para `dotnet run` local: puerto 5433, no 5432, porque docker-compose mapea ahí
# para no chocar con un Postgres nativo que pueda estar corriendo como servicio
# de Windows en el puerto default. Dentro de Compose, docker-compose.yml pisa
# esta variable con Host=db;Port=5432.
FLETAR_CS=Host=localhost;Port=5433;Database=fletar;Username=fletar;Password=<password local>

# La API aplica migraciones al arrancar sólo si esto vale "true" (lo setea
# docker-compose.yml). En local se usa `dotnet ef database update`.
# FLETAR_MIGRATE_ON_START=true

# Alternativa a FLETAR_CS para proveedores administrados (Neon, Railway, Render):
# la API acepta DATABASE_URL en formato postgresql://usuario:password@host/db.
# FLETAR_CS tiene prioridad si están las dos.
# DATABASE_URL=postgresql://usuario:password@host:5432/fletar?sslmode=require

# En producción el filesystem del contenedor es efímero: apuntar al volumen
# persistente. En local se usa FLETAR_BACKEND/src/Fletar.API/uploads.
# FLETAR_UPLOADS_PATH=/data/uploads

# Clave de firma del JWT (HMAC SHA-256): al menos 32 bytes UTF-8, aleatoria por entorno.
FLETAR_JWT_KEY=<clave aleatoria de al menos 32 caracteres>
FLETAR_JWT_ISSUER=FletAR
FLETAR_JWT_AUDIENCE=FletAR

# Login con Google - Client ID de tipo "Web application" en Google Cloud Console
# (Credenciales > Crear credenciales > ID de cliente de OAuth). Se usa como
# audience para validar el ID token, tanto si lo manda el cliente Android, iOS
# o Web (ver CLAUDE.md, sección Login con Google, para el paso a paso).
# Opcional: sin esto, /auth/google responde error pero el resto de la API arranca igual.
# FLETAR_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# Orígenes permitidos por CORS para el cliente web en producción, separados por
# coma. En Development se permite cualquier origen (el puerto de `flutter run
# -d chrome` cambia cada vez). Vacío por defecto: sin esto, el cliente web
# publicado no va a poder llamar a la API.
# FLETAR_CORS_ORIGENES=https://app.fletar.ar

# Monitoreo de errores con Sentry (opcional). Sin DSN la API arranca igual y no
# manda nada. Usar un proyecto distinto para producción y development.
# SENTRY_DSN=https://<public-key>@o<org>.ingest.sentry.io/<project-id>
# SENTRY_ENVIRONMENT=production

# Firebase Admin SDK (Fase 5 - push notifications). Nombre estándar de las
# Application Default Credentials de Google - GoogleCredential.GetApplicationDefault()
# lo lee solo. Opcional: sin esto, FcmSenderService no envía nada (no rompe nada).
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/firebase-service-account.json
